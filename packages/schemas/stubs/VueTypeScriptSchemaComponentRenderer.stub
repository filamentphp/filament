import { createApp, h, shallowRef } from 'vue'
import type { JsComponentProps, JsComponentRenderer } from '@filament/schemas/js-component'
import {{ componentIdentifier }} from './{{ componentName }}.vue'

type Configuration = { message?: string }

const mount{{ componentName }}: JsComponentRenderer<Configuration> = ({ host, props: initialProps }) => {
    const props = shallowRef<JsComponentProps<Configuration>>(initialProps)
    const application = createApp({
        setup: () => () => h({{ componentIdentifier }}, props.value),
    })

    application.mount(host)

    return {
        update(nextProps) {
            props.value = nextProps
        },
        destroy: () => application.unmount(),
    }
}

export default mount{{ componentName }}
