import { createApp, h, shallowRef } from 'vue'
import type { JsComponentProps, JsComponentRenderer } from '@filament/schemas/js-component'
import {{ componentName }} from './{{ componentName }}.vue'

type Config = { message?: string }

const mount{{ componentName }}: JsComponentRenderer<Config> = ({ host, props: initialProps }) => {
    const props = shallowRef<JsComponentProps<Config>>(initialProps)
    const application = createApp({
        setup: () => () => h({{ componentName }}, props.value),
    })

    application.mount(host)

    return {
        update(nextProps) {
            props.value = nextProps
        },
        destroy: () => application.unmount(),
    }
}

export default mount{{ componentName }}
