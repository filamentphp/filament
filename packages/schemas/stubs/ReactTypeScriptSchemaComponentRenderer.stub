import React from 'react'
import { flushSync } from 'react-dom'
import { createRoot } from 'react-dom/client'
import type { JsComponentProps, JsComponentRenderer } from '@filament/schemas/js-component'

type Configuration = { message?: string }

function {{ componentIdentifier }}(props: JsComponentProps<Configuration>) {
    return <p>{props.configuration.message ?? 'Your component is ready.'}</p>
}

const mount{{ componentName }}: JsComponentRenderer<Configuration> = ({ host, props: initialProps }) => {
    const root = createRoot(host)
    const update = (props: JsComponentProps<Configuration>) => root.render(<{{ componentIdentifier }} {...props} />)

    try {
        flushSync(() => update(initialProps))
    } catch (error) {
        root.unmount()
        throw error
    }

    return { update, destroy: () => root.unmount() }
}

export default mount{{ componentName }}
