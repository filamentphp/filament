import { createApp, h, shallowRef } from 'vue'
import {{ componentIdentifier }} from './{{ componentName }}.vue'

export default function mount{{ componentName }}({ host, props: initialProps }) {
    const props = shallowRef(initialProps)
    const application = createApp({
        setup: () => () => h({{ componentIdentifier }}, props.value),
    })

    application.mount(host)

    return {
        update(nextProps) {
            props.value = nextProps
        },
        destroy: () => application.unmount(),
    }
}
