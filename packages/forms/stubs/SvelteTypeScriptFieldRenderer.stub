import { mount, unmount } from 'svelte'
import type { JsFieldInitialProps, JsFieldRenderer } from '@filament/forms/js-field'
import {{ componentName }} from './{{ componentName }}.svelte'

const mount{{ componentName }}: JsFieldRenderer<string | null> = ({ host, props: initialProps }) => {
    const props = $state<JsFieldInitialProps<string | null>>({ ...initialProps })
    const component = mount({{ componentName }}, { target: host, props })

    return {
        update: (nextProps) => {
            Object.assign(props, nextProps)
        },
        destroy: () => unmount(component),
    }
}

export default mount{{ componentName }}
