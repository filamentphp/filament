{{ componentTypeImport }}
const pages = import.meta.glob{{ globType }}('./pages/**/*.{jsx,tsx}')

export function resolve(name{{ nameType }}) {
    if (!name.startsWith('Filament/')) {
        throw new Error(`Unknown Filament page: ${name}`)
    }

    const component = `./pages/${name.slice('Filament/'.length)}`
    const page = pages[`${component}.jsx`] ?? pages[`${component}.tsx`]

    if (!page) {
        throw new Error(`Unknown Filament page: ${name}`)
    }

    return page().then((module) => module.default)
}
