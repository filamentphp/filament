# Testing Environment Configuration
# Copy this file to .env.testing and adjust values for your local setup
#
# USAGE:
# These values are automatically loaded by PHPUnit's bootstrap file.
# Use database-specific variables to configure ports and credentials for each database.
# Use disposable databases only: tests run migrations and delete data.
# The database account must be able to create databases for parallel workers.
#
# AMP ORBS:
# Only the SQLite-backed demo starts automatically.
# Start a test database with `.agents/database start mysql` (or `pgsql`, `sqlsrv`).
# Then run `composer test:mysql` (or `test:pgsql`, `test:sqlsrv`).
# Stop it with `.agents/database stop mysql` (or `pgsql`, `sqlsrv`).
# Stopping the last container also stops Docker; database volumes are preserved.
# MySQL/PostgreSQL images download on first use; SQL Server's image is cached in setup.
# These loopback-only test services use empty MySQL/PostgreSQL passwords and the
# SQL Server password below. Never use this configuration for shared/production data.

# Default Database Configuration
DB_HOST=127.0.0.1
# DB_DATABASE is intentionally not set here - let TestCase.php defaults handle it
# (SQLite needs ":memory:", MySQL/Postgres/SQL Server need "testing")

# PostgreSQL-specific configuration (for non-standard ports)
# PGSQL_PORT=5432
# PGSQL_USERNAME=postgres
# PGSQL_PASSWORD=

# MySQL-specific configuration (uncomment if needed)
# MYSQL_PORT=3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=

# SQL Server-specific configuration (SQL Server 2022 Developer test service)
# Requires `pdo_sqlsrv` and Microsoft's ODBC driver.
# Run `composer test:sqlsrv` and `composer test:serial:sqlsrv`.
# The test database and parallel worker databases are created automatically.
# SQLSRV_PORT=1433
# SQLSRV_USERNAME=sa
# SQLSRV_PASSWORD=Filament_Test123!
# SQLSRV_ENCRYPT=yes
# SQLSRV_TRUST_SERVER_CERTIFICATE=true
# Trusting the self-signed certificate is for local disposable test services only.
